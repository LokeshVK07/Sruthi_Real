{
  "name": "sruthi",
  "compatibility_date": "2026-04-08",
  "main": "src/worker.js",
  "assets": {
    "directory": "public",
    "binding": "ASSETS"
  },
  "vars": {
    "CATALOG_LANGUAGE": "tamil",
    "SYNC_FEED_URL": "https://www.masstamilan.dev/sruthi-sync.json",
    "R2_CACHE_TARGET_BYTES": "7516192768",
    "R2_CACHE_MAX_AUDIO_BYTES": "26214400"
  },
  "triggers": {
    "crons": [
      "23 */12 * * *"
    ]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "sruthi-db",
      "database_id": "7e7f8f48-5f15-4ac8-bec0-37a899ddb33b"
    }
  ],
  "r2_buckets": [
    {
      "binding": "AUDIO_BUCKET",
      "bucket_name": "sruthi-audio-cache"
    }
  ]
}
